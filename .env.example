# Copy this file to .env and fill in the values (needed for the agent).
# .env is git-ignored, so keys never reach GitHub.

# Any OpenAI-compatible API. Default: Google Gemini free tier (no credit card).
# Get a free key at https://aistudio.google.com/apikey
# Other options:
#   OpenAI:    https://api.openai.com/v1
#   Anthropic: https://api.anthropic.com/v1/
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=

# Exact model name from the provider's model list
MODEL=gemini-3.5-flash-lite
